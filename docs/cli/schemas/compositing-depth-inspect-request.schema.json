{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compositing-depth-inspect-request.schema.json",
  "title": "Experimental compositing.depth-inspect request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "const": "compositing.depth-inspect"
    },
    "params": {
      "type": "object",
      "properties": {
        "depth_inspect_version": {
          "const": "1.0"
        },
        "bundle": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/]|$))"
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file",
            "expected_sha256"
          ],
          "additionalProperties": false
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/]|$))"
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file",
              "expected_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "depth_inspect_version",
        "bundle",
        "resources"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "compositing.depth-inspect params v1.0",
      "$comment": "Strict reader/type and direct bundle resource coverage are semantic requirements; Host dynamically verifies every extra authority resource is used."
    }
  },
  "required": [
    "schema_version",
    "command",
    "params"
  ],
  "additionalProperties": false
}
